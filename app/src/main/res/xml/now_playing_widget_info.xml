<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis=0: the widget is push-driven from the player; it never wakes the device on a timer.
  targetCell*/maxResize*/previewLayout/description apply on Android 12+; minWidth/minHeight cover older launchers.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_now_playing_xl"
    android:maxResizeHeight="420dp"
    android:maxResizeWidth="560dp"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="50dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_now_playing_xl"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
