<?xml version="1.0" encoding="utf-8"?>
<!-- Background stack shared by every widget size: colour tint → blurred cover (API 31+) → scrim. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/widget_bg_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        android:tint="@color/widget_fallback_background" />

    <ImageView
        android:id="@+id/widget_bg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.85"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_scrim" />
</merge>
