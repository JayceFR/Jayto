<?xml version="1.0" encoding="utf-8"?>
<!-- Accent-filled circular play/pause button. Sized by the including layout. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_play_button"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:contentDescription="@string/widget_play">

    <ImageView
        android:id="@+id/widget_play_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_circle"
        android:tint="@color/widget_fallback_accent" />

    <ImageView
        android:id="@+id/widget_play"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_play"
        android:tint="@color/widget_fallback_on_accent" />
</FrameLayout>
