<?xml version="1.0" encoding="utf-8"?>
<!-- Shown when a song has no artwork, and in the static picker preview. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="96dp" android:height="96dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/widget_placeholder_background" />
        </shape>
    </item>
    <item
        android:width="40dp"
        android:height="40dp"
        android:gravity="center"
        android:drawable="@drawable/ic_widget_music_note_tinted" />
</layer-list>
